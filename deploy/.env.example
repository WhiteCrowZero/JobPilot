# JobPilot P0 阶段部署配置
# 目标：只启动本地开发所需基础设施，API 和 Worker 使用本机 uv run 启动。
# P1 之前暂不保留 pgAdmin / Prometheus / Grafana / Elasticsearch / 前端相关配置。

TZ=Asia/Shanghai

POSTGRES_EXPORT_PORT=15432
POSTGRES_TEST_EXPORT_PORT=15433
POSTGRES_DB=jobpilot
POSTGRES_TEST_DB=jobpilot_test
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot

REDIS_EXPORT_PORT=16379
REDIS_PASSWORD=jobpilot_redis

RABBITMQ_EXPORT_PORT=15674
RABBITMQ_MANAGEMENT_EXPORT_PORT=15675
RABBITMQ_DEFAULT_USER=jobpilot
RABBITMQ_DEFAULT_PASS=jobpilot_rabbitmq
