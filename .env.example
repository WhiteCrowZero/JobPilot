APP_NAME=JobPilot
APP_ENV=local
DEBUG=true
API_PREFIX=/api
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# Use a long random secret in real environments.
SECRET_KEY=change-me-to-a-long-random-secret-key-for-jobpilot
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
TEST_DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5433/jobpilot_test
DATABASE_ECHO=false

REDIS_URL=redis://:jobpilot_redis@localhost:6389/0
CELERY_BROKER_URL=redis://:jobpilot_redis@localhost:6389/1
CELERY_RESULT_BACKEND=redis://:jobpilot_redis@localhost:6389/2

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
