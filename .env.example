APP_NAME=JobPilot
APP_ENV=local
DEBUG=false
API_PREFIX=/api
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# Use a long random secret in real environments.
SECRET_KEY=change-me-to-a-long-random-secret-key-for-jobpilot
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@127.0.0.1:5432/jobpilot
TEST_DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@127.0.0.1:5433/jobpilot_test
DATABASE_ECHO=false

REDIS_URL=redis://:jobpilot_redis@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:jobpilot_redis@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:jobpilot_redis@127.0.0.1:6379/2

MAX_UPLOAD_SIZE_MB=20
BACKEND_CORS_ORIGINS=["http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=INFO
LOG_DIR=./logs
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_COLOR=true
LOG_FILE_ENABLED=true
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_SUPPRESS_FRAMEWORK_LOGS=true
LOG_REQUEST_ENABLED=true
LOG_REQUEST_SKIP_PATHS=["/health","/health/readiness","/api/v1/health","/api/v1/health/readiness","/docs","/redoc","/openapi.json","/api/v1/openapi.json","/favicon.ico"]
